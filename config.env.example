# Copy to config.env and fill in. config.env is gitignored — never commit it.

# ---- AWS basics ----
export AWS_PROFILE="default"           # 本地用的 AWS profile
export REGION="us-east-1"              # 实例所在区域（和 S3 桶同区以省出口费）
export S3_BUCKET="your-oss-image-lab-bucket"   # 结果存放桶（需已存在，同区域）

# ---- Instance ----
# 高质量首选：g6e.xlarge = 1x NVIDIA L40S 48GB，可跑 BF16 全精度
export INSTANCE_TYPE="g6e.xlarge"
export KEY_NAME="your-ec2-keypair"     # 已存在的 EC2 key pair 名
export SSH_KEY_PATH="$HOME/.ssh/your-ec2-keypair.pem"
# Deep Learning OSS Nvidia Driver AMI (Ubuntu 22.04)。用脚本自动解析最新的，见 provision.sh。
# 也可手动固定一个 AMI ID：
export AMI_ID=""                       # 留空则 provision.sh 自动查询最新 DLAMI

# ---- EBS 权重卷（独立卷，stop 后保留，避免重复下载 ~32GB 权重）----
export WEIGHTS_VOLUME_SIZE_GB="150"    # 存模型权重 + ComfyUI + 输出缓存
export ROOT_VOLUME_SIZE_GB="80"

# ---- 省钱兜底：空闲自动关机 ----
export IDLE_SHUTDOWN_MINUTES="30"      # GPU 空闲超过此分钟数自动 shutdown

# ---- 运行时填充（provision.sh 写入，勿手动改）----
export INSTANCE_ID=""
export SECURITY_GROUP_ID=""
export WEIGHTS_VOLUME_ID=""

# ---- 可选：只允许你的 IP SSH（强烈建议）----
export MY_IP_CIDR=""                   # 例如 203.0.113.5/32；留空则用 0.0.0.0/0（不安全）
